# LinkedIn Session Cookie (from dedicated account only!)
LI_AT_COOKIE=

# Proxy (optional, for residential proxy rotation)
PROXY_URL=

# SMTP validation (optional)
SMTP_FROM_EMAIL=verify@yourdomain.com

# Rate limiting
RATE_LIMIT_RPM=20
MIN_DELAY=2.0
MAX_DELAY=7.0

# Database
DB_PATH=data/prospector.db

# Output
OUTPUT_DIR=output
