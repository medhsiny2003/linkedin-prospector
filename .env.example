# ==============================================================================
# ⚠️ ASSISTANT DE PROSPECTION LINKEDIN (V3.1) - CONFIGURATION D'ENVIRONNEMENT
# ⚠️ RECOMMANDATION CRITIQUE : Utilisez un compte LinkedIn secondaire/dédié !
# ==============================================================================

# --- AUTHENTIFICATION LINKEDIN ---
# Méthode 1 (Recommandée) : Cookie li_at extrait depuis votre navigateur
# Pour obtenir le cookie : F12 > Application > Cookies > https://www.linkedin.com > li_at
LINKEDIN_COOKIE=

# Méthode 2 : Identifiants (Optionnel, utile si renouvellement automatique requis)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# --- PROXIES RÉSIDENTIELS (Optionnel mais recommandé en production) ---
# Format : http://user:password@proxy_host:port ou socks5://...
# ⚠️ Note : Évitez les proxies Datacenter facilement blacklistés par LinkedIn.
PROXY_URL=

# --- SERVEUR MCP LINKEDIN (Optionnel) ---
# Activer l'intégration FastMCP / Model Context Protocol pour LinkedIn
USE_MCP_SERVER=false
MCP_SERVER_URL=http://localhost:8000/mcp

# --- PARAMÈTRES DE SÉCURITÉ & LIMITES ---
# Limite stricte d'invitations journalières (Max 20 recommandé)
DAILY_CONNECT_LIMIT=20

# Délais aléatoires entre chaque action (en secondes)
REQUEST_DELAY_MIN=3
REQUEST_DELAY_MAX=10

# Mode de navigation (TOUJOURS False pour éviter la détection headless)
HEADLESS=false

# Fuseau horaire et localisation
TIMEZONE=Europe/Paris
LOCALE=fr-FR

# --- STOCKAGE ET CHEMINS ---
SESSION_PATH=data/sessions/linkedin_profile
DATABASE_PATH=data/leads.db
OUTPUT_EXCEL_PATH=data/contacts_stage.xlsx
AUDIT_LOG_PATH=logs/audit.json
